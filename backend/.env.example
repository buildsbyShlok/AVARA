# Copy only if backend/.env does not already exist. Never overwrite existing secrets.
NODE_ENV=development
PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/wanderlust
# Generate a random value with at least 32 characters; do not use a shared default.
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Set to the exact number of trusted reverse-proxy hops for your deployment.
TRUST_PROXY=0
# Relative to backend/ or an absolute persistent storage directory.
UPLOAD_DIR=uploads
